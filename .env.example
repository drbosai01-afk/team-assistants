# === Telegram ===
BOT_TOKEN=7012345678:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_IDS=123456789

# === Деплой ===
PUBLIC_URL=
PORT=8080
MODE=polling

# === LLM ===
# Провайдеры (выбери один):
# groq       — Llama, БЕСПЛАТНО, через ВПН
# openrouter — Claude/GPT, нужна карта + ВПН
# openai     — прямой OpenAI
# proxy      — любой OpenAI-совместимый
# gigachat   — Сбер, РФ без ВПН
LLM_PROVIDER=groq

# --- Для groq (рекомендую для РФ с ВПН) ---
LLM_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=llama-3.1-70b-versatile

# --- Для openrouter ---
# LLM_API_KEY=sk-or-v1-xxx
# LLM_MODEL=anthropic/claude-3.5-sonnet

# --- Для openai ---
# LLM_API_KEY=sk-xxx
# LLM_MODEL=gpt-4o-mini

# --- Для gigachat ---
# LLM_PROVIDER=gigachat
# GIGACHAT_CREDENTIALS=xxx
# GIGACHAT_MODEL=GigaChat-Pro

# --- Для proxy ---
# LLM_BASE_URL=https://your-proxy.com/v1
